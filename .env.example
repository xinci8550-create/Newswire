# ============================================================
# News Aggregator - Environment Variables (.env.example)
# Copy to `.env` (server/) before running. NEVER commit real secrets.
# ============================================================

# ---- Server ----
# Port the API/static server listens on
PORT=4000

# Node environment: development | production
NODE_ENV=development

# ---- Database ----
# Leave DATABASE_URL empty to use the built-in SQLite file (local/dev).
# Set to a PostgreSQL connection string to use Postgres (production/free tier).
# Examples:
#   postgres://user:pass@host:5432/dbname
#   postgresql://user:pass@host:5432/dbname?ssl=true
DATABASE_URL=

# Path of the SQLite file (only used when DATABASE_URL is empty)
SQLITE_PATH=./data/news.sqlite

# ---- Auth / JWT ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-generate-a-64-hex-secret
JWT_REFRESH_SECRET=change-me-generate-another-64-hex-secret
# Access token lifetime in seconds (default 15 min = 900)
JWT_ACCESS_TTL=900
# Refresh token lifetime in seconds (default 30 days = 2592000)
JWT_REFRESH_TTL=2592000

# ---- Scraper / Scheduler ----
# How often (in minutes) to run the feed-fetch job inside the server process.
# A separate external scheduler can hit POST /api/cron/trigger (see CRON_SECRET).
SCRAPE_INTERVAL_MINUTES=30
# Secret used to authenticate the external cron-trigger endpoint.
CRON_SECRET=change-me-cron-secret
# Enable the in-process scheduler (true|false). Set false if using external cron only.
ENABLE_IN_PROCESS_CRON=true

# ---- Frontend / CORS ----
# Comma-separated list of allowed origins for the API in dev (Vite dev server).
CORS_ORIGINS=http://localhost:5173

# ---- Optional tweaks / Retention (keeps the DB bounded) ----
# Max articles to keep per source during cleanup (default 1000).
MAX_ARTICLES_PER_SOURCE=1000
# Delete articles older than this many days (favorites are always kept) (default 30).
ARTICLE_RETENTION_DAYS=30
# Max browsing-history entries kept per user (default 200).
HISTORY_LIMIT=200
# Enable automatic retention cleanup after each scrape (default true).
CLEANUP_ENABLED=true
